From e8adc4177e552960d43c89aaf9ad22afc1208cda Mon Sep 17 00:00:00 2001
From: Kent Overstreet <kent.overstreet@linux.dev>
Date: Tue, 17 Mar 2026 13:13:25 -0400
Subject: [PATCH 01/14] package-ci: add PUBLISH_ROOT config for aptly publish
 endpoint

The aptly FileSystemPublishEndpoint was hardcoded to $APTLY_ROOT/public,
but nginx serves from a different directory (public_html). Add a
PUBLISH_ROOT config variable so the publish endpoint can be pointed
directly at the nginx document root.

Set PUBLISH_ROOT=/home/aptbcachefsorg/uploads/public_html in the
server config and move existing published content there.

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 package-ci/scripts/publish.sh | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/package-ci/scripts/publish.sh b/package-ci/scripts/publish.sh
index 878fcb33..91c1d68e 100755
--- a/package-ci/scripts/publish.sh
+++ b/package-ci/scripts/publish.sh
@@ -10,6 +10,7 @@
 # Config read from $STATE_DIR/config:
 #   GPG_SIGNING_SUBKEY_FINGERPRINT
 #   APTLY_ROOT
+#   PUBLISH_ROOT  (where nginx serves from; defaults to $APTLY_ROOT/public)
 
 set -euo pipefail
 
@@ -25,6 +26,7 @@ SHORT="${COMMIT:0:12}"
 source "$STATE_DIR/config"
 : "${GPG_SIGNING_SUBKEY_FINGERPRINT:?not set in config}"
 : "${APTLY_ROOT:?not set in config}"
+: "${PUBLISH_ROOT:=$APTLY_ROOT/public}"
 
 SNAPSHOT_DATE="$(date -u +%Y%m%d%H%M%S)"
 
@@ -38,7 +40,7 @@ cat > "$APTLY_CONF" << EOF
     "skipContentsPublishing": true,
     "FileSystemPublishEndpoints": {
         "public": {
-            "rootDir": "$APTLY_ROOT/public",
+            "rootDir": "$PUBLISH_ROOT",
             "linkMethod": "symlink"
         }
     }
-- 
