From 97dd3614ebf9edaa481df5b5c56a6e087e34dec1 Mon Sep 17 00:00:00 2001
From: Kent Overstreet <kent.overstreet@linux.dev>
Date: Tue, 17 Mar 2026 23:25:28 -0400
Subject: [PATCH 13/14] Fix 32-bit segfault: struct sysinfo missing kernel
 padding field

The custom struct sysinfo in include/linux/mm.h was missing the _f
padding field from the kernel's UAPI definition. On 64-bit this padding
is 0 bytes so the omission was harmless, but on 32-bit it's 8 bytes:
syscall(SYS_sysinfo) writes the full 64-byte kernel struct into a
56-byte compiler-allocated struct, overflowing into saved registers on
the stack.

On i686 (PIE binary), the overflow zeroed the saved %ebx (PIC/GOT base
pointer). After linux_shrinkers_init() returned, all PIC-relative
addresses resolved to garbage, causing a null pointer jump in the
command dispatch table.

Closes: https://github.com/koverstreet/bcachefs-tools/issues/1080

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 include/linux/mm.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/linux/mm.h b/include/linux/mm.h
index cbcc86e6..1dad3bb5 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -21,6 +21,12 @@ struct sysinfo {
 	unsigned long totalhigh;	/* Total high memory size */
 	unsigned long freehigh;	/* Available high memory size */
 	__u32 mem_unit;			/* Memory unit size in bytes */
+	/*
+	 * Padding to match the kernel's struct sysinfo layout. 8 bytes on
+	 * 32-bit, 0 on 64-bit. Without this, syscall(SYS_sysinfo) writes
+	 * past the end of the struct and corrupts the stack on 32-bit.
+	 */
+	char _f[20 - 2 * sizeof(unsigned long) - sizeof(__u32)];
 };
 
 static inline void si_meminfo(struct sysinfo *val)
