From e0877591b994c69d9d704b68d6afd0a108df411c Mon Sep 17 00:00:00 2001
From: Kent Overstreet <kent.overstreet@linux.dev>
Date: Tue, 17 Mar 2026 13:39:13 -0400
Subject: [PATCH 04/14] build-source: clone with --tags so git describe works

Without --tags, the cloned repo has no tags and git describe fails,
causing the version to fall through to the stale debian/changelog.

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 package-ci/scripts/build-source.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package-ci/scripts/build-source.sh b/package-ci/scripts/build-source.sh
index e3143a8a..fb9c7cad 100755
--- a/package-ci/scripts/build-source.sh
+++ b/package-ci/scripts/build-source.sh
@@ -30,7 +30,7 @@ echo "=== Building source package for $COMMIT ==="
 WORK_DIR=$(mktemp -d)
 trap 'cleanup; rm -rf "$WORK_DIR"' EXIT
 
-git clone "$GIT_REPO" "$WORK_DIR/bcachefs-tools"
+git clone --tags "$GIT_REPO" "$WORK_DIR/bcachefs-tools"
 cd "$WORK_DIR/bcachefs-tools"
 git checkout "$COMMIT"
 
-- 
2.53.0

