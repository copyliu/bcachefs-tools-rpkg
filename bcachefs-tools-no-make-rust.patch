From 9ccc32db6cbac9d0f24bdf88316aefd82a837b67 Mon Sep 17 00:00:00 2001
From: Neal Gompa <ngompa@fedoraproject.org>
Date: Thu, 29 Aug 2024 09:39:18 -0400
Subject: [PATCH] Makefile: Do not run Rust builds

We are going to run it separately.
---
 Makefile | 19 +------------------
 1 file changed, 1 insertion(+), 18 deletions(-)

diff --git a/Makefile b/Makefile
index 7d1812ce..359086e1 100644
--- a/Makefile
+++ b/Makefile
@@ -16,10 +16,8 @@ endif
 
 ifeq ($(BUILD_VERBOSE),1)
   Q =
-  CARGO_CLEAN_ARGS = --verbose
 else
   Q = @
-  CARGO_CLEAN_ARGS = --quiet
 endif
 
 # when cross compiling, cargo places the built binary in a different location
@@ -56,20 +54,6 @@ CFLAGS+=-std=gnu11 -O2 -g -MMD -Wall -fPIC			\
 # recursive expansion here (CFLAGS is not yet completely built by this line)
 LDFLAGS+=$(CFLAGS) $(EXTRA_LDFLAGS)
 
-ifdef CARGO_TOOLCHAIN_VERSION
-  CARGO_TOOLCHAIN = +$(CARGO_TOOLCHAIN_VERSION)
-endif
-
-CARGO_ARGS=${CARGO_TOOLCHAIN}
-CARGO=cargo $(CARGO_ARGS)
-CARGO_PROFILE=release
-# CARGO_PROFILE=debug
-
-CARGO_BUILD_ARGS=--$(CARGO_PROFILE)
-CARGO_BUILD=$(CARGO) build $(CARGO_BUILD_ARGS)
-
-CARGO_CLEAN=$(CARGO) clean $(CARGO_CLEAN_ARGS)
-
 include Makefile.compiler
 
 CFLAGS+=$(call cc-disable-warning, unused-but-set-variable)
@@ -181,7 +165,7 @@ BCACHEFS_DEPS=libbcachefs.a
 RUST_SRCS:=$(shell find src bch_bindgen/src -type f -iname '*.rs')
 
 bcachefs: $(BCACHEFS_DEPS) $(RUST_SRCS)
-	$(Q)$(CARGO_BUILD)
+	@echo "    [RUST]   Skipped."
 
 libbcachefs.a: $(OBJS)
 	@echo "    [AR]     $@"
@@ -227,7 +211,6 @@ install_systemd: $(systemd_services) $(systemd_libexecfiles)
 clean:
 	@echo "Cleaning all"
 	$(Q)$(RM) libbcachefs.a c_src/libbcachefs.a .version *.tar.xz $(OBJS) $(DEPS) $(DOCGENERATED)
-	$(Q)$(CARGO_CLEAN)
 	$(Q)$(RM) -f $(built_scripts)
 
 .PHONY: deb
-- 
2.49.0

