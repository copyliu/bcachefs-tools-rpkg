 static int do_cmp(const void *a, const void *b, cmp_r_func_t cmp, const void *priv)
 {
 	if (cmp == _CMP_WRAPPER)
-		return ((const struct wrapper *)priv)->cmp(a, b);
+		return ((const struct wrapper *)priv)->cmp_fn(a, b);
 	return cmp(a, b, priv);
 }
 
