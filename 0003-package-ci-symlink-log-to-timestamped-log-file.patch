From a75acf2a292a323ff0a8a3258d262ffc4e055096 Mon Sep 17 00:00:00 2001
From: Kent Overstreet <kent.overstreet@linux.dev>
Date: Tue, 17 Mar 2026 13:27:28 -0400
Subject: [PATCH 03/14] package-ci: symlink 'log' to timestamped log file

The timestamped log filenames (log-YYYYMMDDTHHMMSS) broke the ci.html
links which expect /ci-builds/{commit}/{job}/log. Add a 'log' symlink
pointing to the timestamped file so both work.

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 package-ci/src/main.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/package-ci/src/main.rs b/package-ci/src/main.rs
index 037f6343..999d07e5 100644
--- a/package-ci/src/main.rs
+++ b/package-ci/src/main.rs
@@ -248,7 +248,13 @@ impl BuildState {
 
     fn log_path(&self, commit: &str, job_name: &str) -> PathBuf {
         let now = chrono::Utc::now().format("%Y%m%dT%H%M%S");
-        self.job_dir(commit, job_name).join(format!("log-{}", now))
+        let dir = self.job_dir(commit, job_name);
+        let timestamped = dir.join(format!("log-{}", now));
+        // Symlink "log" → timestamped file so ci.html links work
+        let stable = dir.join("log");
+        let _ = std::fs::remove_file(&stable);
+        let _ = std::os::unix::fs::symlink(format!("log-{}", now), &stable);
+        timestamped
     }
 
     fn pid_path(&self, commit: &str, job_name: &str) -> PathBuf {
